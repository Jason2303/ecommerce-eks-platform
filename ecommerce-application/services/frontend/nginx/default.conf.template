# Rendered at container start by the nginx image entrypoint (envsubst).
# ${GATEWAY_URL} defaults to http://gateway:3000 (set in the Dockerfile).
# In Kubernetes the Ingress sends /api straight to the gateway,
# so the /api block below is only used by Docker Compose.

server {
    listen       8080;
    server_name  _;
    root         /usr/share/nginx/html;

    server_tokens off;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;

    # Probes hit this, not the SPA.
    location = /healthz {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok","service":"frontend"}';
    }

    location /api/ {
        proxy_pass         ${GATEWAY_URL};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 15s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
    }
}
